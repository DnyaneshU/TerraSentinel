# Copy this file to .env and fill in your key:  cp .env.example .env
# Get a key at https://console.anthropic.com/settings/keys

# Required for AI review (not needed for --scan-only mode)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# TERRASENTINEL_MODEL=claude-opus-4-8        # claude-sonnet-4-6 / claude-haiku-4-5 to cut cost
# TERRASENTINEL_MAX_TOKENS=8000

# Only needed when posting comments to GitHub PRs (the GitHub Action sets these automatically)
# GITHUB_TOKEN=ghp_...
# GITHUB_REPOSITORY=owner/repo
# GITHUB_PR_NUMBER=123
